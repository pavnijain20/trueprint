# Example environment values. Configure them explicitly in your hosting provider; never commit secrets.
DATABASE_PATH=./data/trueprint.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false
DEMO_REQUIRE_ROLE_CODES=true

# For local testing, set DEMO_MODE=true and DEMO_REQUIRE_ROLE_CODES=false in PowerShell.
# For a controlled hosted judging demo, keep role codes required and configure four
# different strong values in the hosting provider's secret UI.
# DEMO_CREATOR_CODE=
# DEMO_MANAGER_CODE=
# DEMO_REVIEWER_CODE=
# DEMO_ADMIN_CODE=
